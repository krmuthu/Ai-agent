# OpenAI-compatible endpoint. Point this at a local open-weight server
# (llama.cpp, vLLM, Ollama, LM Studio, ...) or at api.openai.com.
OPENAI_BASE_URL=http://localhost:11434/v1
OPENAI_API_KEY=sk-local
AGENT_MODEL=qwen2.5-coder:14b

# Loop + context safeguards
AGENT_MAX_ITERATIONS=20
AGENT_CONTEXT_TOKENS=32768
AGENT_COMPACTION_THRESHOLD=0.85
AGENT_KEEP_RECENT_TURNS=6

# Tool safeguards
AGENT_WORKSPACE=.
AGENT_COMMAND_TIMEOUT_MS=60000
AGENT_MAX_OUTPUT_CHARS=20000

# Optional MCP bridge endpoint used by the mcp_call tool
MCP_SERVER_URL=
